{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Syllen",
  "version": "0.1.0",
  "identifier": "app.syllen.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Syllen",
        "width": 1040,
        "height": 780,
        "minWidth": 720,
        "minHeight": 560,
        "backgroundColor": "#f1f1ee"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**", "$APPDATA/**"]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["sidecar/**/*", "resources/bin/*"]
  }
}
