{
  "name": "yt-transcript",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "^22.12.0 || ^24 || >=26"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run && node --test scripts/hooks.check.mjs scripts/model-integrity.check.mjs scripts/ort-thread-options.check.mjs",
    "prepush": "npm run typecheck && npm test && cd src-tauri && cargo clippy --all-targets --locked -- -D warnings && cargo test --locked",
    "sidecar:install": "npm --prefix src-tauri/sidecar install",
    "sidecar:prepare": "node scripts/prepare-sidecar.mjs",
    "tauri:build": "npm run sidecar:prepare && tauri build"
  },
  "dependencies": {
    "@desert-ant-labs/who": "^4.2.3",
    "@litertjs/core": "^2.6.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.2.1",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  },
  "description": "Local video and audio transcription with speaker labels",
  "license": "MIT"
}
